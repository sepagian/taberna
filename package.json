{
  "name": "taberna",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vp dev & drizzle-kit studio --config='./drizzle.local.config.ts'",
    "build": "wrangler types --check && vp build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "husky",
    "check": "ultracite check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "db:push": "drizzle-kit push",
    "db:push:local": "drizzle-kit push --config='./drizzle.local.config.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:local": "drizzle-kit studio --config='./drizzle.local.config.ts'",
    "fix": "ultracite fix",
    "test": "vp test run --exclude 'tests/**'",
    "test:e2e": "NODE_ENV=development bunx playwright test"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.11",
    "@better-auth/kysely-adapter": "^1.6.11",
    "@better-auth/utils": "^0.4.0",
    "@humanspeak/svelte-motion": "^0.3.6",
    "@iconify-svelte/tabler": "^1.0.14",
    "@tanstack/svelte-form": "^1.32.0",
    "@unocss/reset": "^66.6.8",
    "@unocss/svelte-scoped": "^66.6.8",
    "better-sqlite3": "^12.10.0",
    "bits-ui": "^2.18.0",
    "cross-env": "^10.1.0",
    "kysely": "~0.28.17",
    "kysely-codegen": "^0.20.0",
    "kysely-d1": "^0.4.0",
    "mode-watcher": "^1.1.0",
    "svelte-i18n": "^4.0.1",
    "svelte-sonner": "^1.1.1",
    "unocss": "^66.6.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@internationalized/date": "^3.12.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.8.0",
    "better-auth": "1.6.11",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "sql.js": "^1.14.1",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "wrangler": "^4.92.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.13"
}
