{
	"name": "taberna",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "wrangler types --check && vp build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"dependencies": {
		"@better-auth/core": "^1.6.9",
		"@better-auth/kysely-adapter": "^1.6.9",
		"@better-auth/telemetry": "^1.6.9",
		"@better-auth/utils": "^0.4.0",
		"@libsql/client": "^0.17.3",
		"@unocss/reset": "^66.6.8",
		"@unocss/svelte-scoped": "^66.6.8",
		"better-sqlite3": "^12.9.0",
		"bits-ui": "^2.18.0",
		"cross-env": "^10.1.0",
		"dexie": "^4.4.2",
		"dotenv": "^17.4.2",
		"kysely": "^0.28.16",
		"kysely-codegen": "^0.20.0",
		"kysely-d1": "^0.4.0",
		"svelte-i18n": "^4.0.1",
		"unocss": "^66.6.8",
		"vaul-svelte": "^0.3.2"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@biomejs/biome": "2.4.14",
		"@iconify/svelte": "^5.2.1",
		"@paralleldrive/cuid2": "^3.3.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.6.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"better-auth": "1.6.9",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.3",
		"ultracite": "7.6.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@latest",
		"vite-plus": "latest",
		"wrangler": "^4.86.0"
	},
	"packageManager": "bun@1.3.13",
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@latest",
		"vitest": "npm:@voidzero-dev/vite-plus-test@latest"
	}
}
